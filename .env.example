# Urban Oasis Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/urban-oasis
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/urban-oasis

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=30d

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Weather API (optional - app works with built-in data)
WEATHER_API_KEY=your-openweathermap-api-key

# Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Urban Oasis <noreply@urbanoasis.com>
